#!/bin/sh

. /etc/init.d/func

_pri_tag="ntpd-initd"

log_d "$0 $*"

_pri_ntpd_pidfile=/var/run/ntpd-initd.pid
_pri_ntpd_logfile=/var/run/ntpd-initd.log

ntpd_start () {
  cmd_run start-stop-daemon -S -n ntpd -b -m -p ${_pri_ntpd_pidfile} \
      ${_pri_ntpd_logfile:+-O $_pri_ntpd_logfile} \
      ntpd -- -q ${_pri_ntpd_logfile:+-n -dd}
}

ntpd_stop () {
  cmd_run start-stop-daemon -K -o -n ntpd -p ${_pri_ntpd_pidfile}
}

case "$1" in
"start")
  cmd_run ntpd_start
  ;;
"stop")
  cmd_run ntpd_stop
  ;;
"restart")
  $0 stop && $0 start
  ;;
*)
  cat <<-EOHERE
USAGE
    $(basename "$0") [start | stop]

OPTIONS
    start  Start service
    stop   Stop service

EOHERE
  ;;
esac
