loadimage=fatload mmc 1:1 ${loadaddr} ${bootdir}/Image[K
loadfdt=fatload mmc 1:1 ${fdtaddr} ${bootdir}/dtb/k3-am625-beagleplay.dtb[K
loadbootargs=setenv bootargs ${bootargs_root} ${bootargs_console} ${bootargs_extra}[K
[K
# bootset=2 boot from emmc[K
bootargs_root2=root=/dev/mmcblk0p2 rw rootwait rootfstype=ext4[K
loadimage2=fatload mmc 0:1 ${loadaddr} ${bootdir}/Image[K
loadfdt2=fatload mmc 0:1 ${fdtaddr} ${bootdir}/dtb/k3-am625-beagleplay.dtb[K
loadbootargs2=${loadbootargs}[K
[K
sdboot=run loadimage${bootset} && run loadfdt${bootset} && run loadbootargs${bootset} && booti ${loadaddr} - ${fdtaddr}[K
bootset=2[K
[K
bootcmd=run sdboot[K
