#include <zephyr/dt-bindings/gpio/nordic-nrf-gpio.h>

/ {
	aliases {
		accel0 = &bmi270;
	};
};

/delete-node/ &lsm9ds1;
/delete-node/ &lsm9ds1_mag;

&i2c1 {
	clock-frequency = <I2C_BITRATE_FAST>;

	bmi270: bmi270@68 {
		compatible = "bosch,bmi270";
		reg = <0x68>;
	};

	bmm150: bmm150@10 {
		compatible = "bosch,bmm150";
		reg = <0x10>;
	};
};

&vdd_env {
	enable-gpios = <&gpio0 22 (GPIO_ACTIVE_HIGH | NRF_GPIO_DRIVE_H0H1)>;
};

/* Sense-only devices from upstream's Sense DTS and Rev2 overlay. */
/ {
    model = "Arduino Nano 33 BLE Sense Rev2 (NCS application overlay)";
    chosen {
        zephyr,console = &uart0;
        zephyr,shell-uart = &uart0;
        zephyr,uart-mcumgr = &uart0;
    };
    mic_pwr: mic_pwr {
        compatible = "regulator-fixed";
        regulator-name = "mic_pwr";
        enable-gpios = <&gpio0 17 GPIO_ACTIVE_HIGH>;
        regulator-boot-on;
    };
};
&i2c1 {
    hs3003: hs3003@44 {
        compatible = "renesas,hs300x";
        reg = <0x44>;
    };
    lps22hb: lps22hb-press@5c {
        compatible = "st,lps22hb-press";
        reg = <0x5c>;
    };
    apds9960: apds9960@39 {
        compatible = "avago,apds9960";
        reg = <0x39>;
        int-gpios = <&gpio0 19 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>;
    };
};
dmic_dev: &pdm0 {
    status = "okay";
    pinctrl-0 = <&pdm0_default>;
    pinctrl-1 = <&pdm0_sleep>;
    pinctrl-names = "default", "sleep";
    clock-source = "PCLK32M_HFXO";
};
&uart0 {
    status = "okay";
    current-speed = <115200>;
    /delete-property/ hw-flow-control;
};
